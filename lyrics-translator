import google.generativeai as genai
import os

# 確保在環境變數或 GitHub Secrets 中設定了 API Key
genai.configure(api_key=os.environ.get("GEMINI_API_KEY"))

def translate_lyrics(original_lyrics: str, target_language: str = "繁體中文") -> str:
    """
    使用 Gemini 模型翻譯歌詞，專注於語感與情感的保留。
    """
    model = genai.GenerativeModel('gemini-2.5-flash')

    prompt = f"""
    你是一位精通多國語言的專業音樂翻譯家與作詞人。
    請將以下歌詞翻譯成{target_language}，並務必遵守以下原則：
    
    1. 語意精準：正確理解原文的文化背景、雙關語與隱喻，避免生硬的直譯。
    2. 詩意與流暢：翻譯結果需具備華語流行音樂的歌詞美感，讀起來順暢自然，字數盡量簡練。
    3. 情感傳遞：完美捕捉原曲的情緒氛圍（如：悲傷、熱血、空靈）。
    4. 格式保留：完全維持原本的段落與換行結構，不增減段落。
    
    請直接輸出翻譯結果，不需要提供任何額外的解釋或說明。
    
    原文歌詞：
    {original_lyrics}
    """

    try:
        response = model.generate_content(prompt)
        return response.text.strip()
    except Exception as e:
        return f"翻譯錯誤: {e}"

# 簡單的測試執行區塊
if __name__ == "__main__":
    sample_text = "I'm walking on sunshine, whoa\nAnd don't it feel good!"
    print("翻譯中...")
    result = translate_lyrics(sample_text)
    print("=== 翻譯結果 ===")
    print(result)
